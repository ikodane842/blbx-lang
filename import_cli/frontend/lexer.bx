from models import Token

// Whitespace separates words. Double quotes retain spaces in a single token.
// Within quotes, a backslash escapes the next character.
tokenize = (source) => {
    state = { "tokens": [], "word": "", "quoted": false, "escape": false, "active": false, "kind": "word" }
    flush = () => {
        if(state.active, () => {
            state.tokens = state.tokens.append(Token(state.kind, state.word))
            state.word = ""
            state.active = false
            state.kind = "word"
        })
    }
    for(source.split(""), (cursor) => {
        char = cursor.elem()
        if(state.quoted, () => {
            if(state.escape, () => {
                state.word = state.word.concat(char)
                state.escape = false
            }, () => {
                if(char.eq("\\"), () => { state.escape = true }, () => {
                    if(char.eq("\""), () => { state.quoted = false }, () => {
                        state.word = state.word.concat(char)
                    })
                })
            })
        }, () => {
            if(char.eq("\""), () => {
                state.quoted = true
                state.active = true
                state.kind = "string"
            }, () => {
                if([" ", "\t", "\r", "\n"].contains(char), () => { flush() }, () => {
                    state.word = state.word.concat(char)
                    state.active = true
                })
            })
        })
    })
    flush()
    state.error = ""
    if(state.quoted, () => { state.error = "Unterminated quoted string." })
    return { "tokens": state.tokens, "error": state.error }
}
